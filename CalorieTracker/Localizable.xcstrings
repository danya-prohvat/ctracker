    "Look back further than 30 days.": {
      "comment": "Subtitle for a feature row in the paywall.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارجع إلى أبعد من ٣٠ يومًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "৩০ দিনেরও বেশি পেছনে দেখুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podívejte se více než 30 dní zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se længere tilbage end 30 dage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau weiter als 30 Tage zurück."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείτε ιστορικό πέρα από τις 30 ημέρες."
          }
        },
