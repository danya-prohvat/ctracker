    "You haven't logged anything today yet. Add your first meal!": {
      "comment": "Text of a notification that appears when the user hasn't logged any meals today.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تسجّل شيئًا اليوم بعد. أضف وجبتك الأولى!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ এখনও কিছু লগ করেননি। প্রথম খাবারটি যোগ করুন!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes jste si ještě nic nezaznamenali. Přidejte své první jídlo!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke logget noget i dag endnu. Tilføj dit første måltid!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast heute noch nichts eingetragen. Füg deine erste Mahlzeit hinzu!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχετε καταγράψει τίποτα σήμερα ακόμη. Προσθέστε το πρώτο σας γεύμα!"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has registrado nada hoy. ¡Añade tu primera comida!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ole kirjannut tänään vielä mitään. Lisää ensimmäinen ateriasi!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez encore rien enregistré aujourd’hui. Ajoutez votre premier repas !"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין לא תיעדתם כלום היום. הוסיפו את הארוחה הראשונה!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज आपने अभी तक कुछ लॉग नहीं किया है। अपना पहला भोजन जोड़ें!"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Danas još niste ništa zabilježili. Dodajte svoj prvi obrok!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma még nem naplóztál semmit. Add hozzá az első étkezésed!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu belum mencatat apa pun hari ini. Tambahkan makanan pertamamu!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi non hai ancora registrato niente. Aggiungi il primo pasto!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日はまだ何も記録されていません。最初の食事を追加しましょう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 아직 기록이 없어요. 첫 식사를 추가해 보세요!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda belum log apa-apa lagi hari ini. Tambah hidangan pertama anda!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke logget noe i dag ennå. Legg til dagens første måltid!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt vandaag nog niets gelogd. Voeg je eerste maaltijd toe!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie masz dziś jeszcze żadnych wpisów. Dodaj pierwszy posiłek!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda não registrou nada hoje. Adicione sua primeira refeição!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não registou nada hoje. Adicione a sua primeira refeição!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Azi nu ai înregistrat încă nimic. Adaugă prima masă!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня вы ещё ничего не записали. Добавьте первый приём пищи!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes ste si ešte nič nezapísali. Pridajte svoje prvé jedlo!"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Danes še niste nič zabeležili. Dodajte svoj prvi obrok!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har inte loggat något idag ännu. Lägg till din första måltid!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้คุณยังไม่ได้บันทึกอะไรเลย มาเพิ่มมื้อแรกกันเถอะ!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün henüz bir şey kaydetmediniz. İlk öğününüzü ekleyin!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні ви ще нічого не записали. Додайте перший прийом їжі!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے آج ابھی کچھ لاگ نہیں کیا۔ اپنا پہلا کھانا شامل کریں!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay bạn chưa ghi gì cả. Thêm bữa ăn đầu tiên nhé!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天还没有任何记录。来添加第一餐吧！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天還沒有任何記錄。來加入第一餐吧！"
          }
        }
      }
    },
    "You still have %@ kcal left today. Log your dinner!": {
      "comment": "A localized string that says how many kcal are left to be logged.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زال لديك %@ سعرة حرارية لليوم. سجّل عشاءك!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ আপনার আরও %@ ক্যালরি বাকি। রাতের খাবার লগ করুন!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes vám ještě zbývá %@ kcal. Zaznamenejte si večeři!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har stadig %@ kcal tilbage i dag. Log din aftensmad!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dir bleiben heute noch %@ kcal. Trag dein Abendessen ein!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σας μένουν ακόμη %@ kcal σήμερα. Καταγράψτε το βραδινό σας!"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún te quedan %@ kcal hoy. ¡Registra tu cena!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinulla on vielä %@ kcal jäljellä tänään. Kirjaa illallisesi!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
