    "The product was found, but its nutrition values are missing. Enter them from the label.": {
      "comment": "A description of why the nutrition values are missing.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور على المنتج، لكن قيمه الغذائية مفقودة. أدخلها من الملصق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পণ্যটি পাওয়া গেছে, কিন্তু এর পুষ্টিমান নেই। লেবেল থেকে সেগুলো লিখুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Produkt byl nalezen, ale chybí jeho nutriční hodnoty. Zadejte je z etikety."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Produktet blev fundet, men dets næringsværdier mangler. Indtast dem fra etiketten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Produkt wurde gefunden, aber die Nährwerte fehlen. Trag sie vom Etikett ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το προϊόν βρέθηκε, αλλά λείπουν οι διατροφικές του τιμές. Εισαγάγετέ τις από την ετικέτα."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El producto se ha encontrado, pero faltan sus valores nutricionales. Introdúcelos desde la etiqueta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuote löytyi, mutta sen ravintoarvot puuttuvat. Syötä ne pakkauksen etiketistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le produit a été trouvé, mais ses valeurs nutritionnelles manquent. Saisissez-les depuis l’étiquette."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המוצר נמצא, אבל חסרים לו ערכים תזונתיים. הזינו אותם מהתווית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोडक्ट मिल गया, लेकिन उसकी पोषण वैल्यू नहीं हैं। उन्हें लेबल से दर्ज करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proizvod je pronađen, ali nedostaju nutritivne vrijednosti. Unesite ih s deklaracije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A termék megvan, de hiányoznak a tápértékadatai. Írd be őket a csomagolásról."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Produk ditemukan, tetapi nilai gizinya belum ada. Masukkan dari label kemasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prodotto è stato trovato, ma mancano i valori nutrizionali. Inseriscili dall’etichetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "商品は見つかりましたが、栄養成分の値がありません。ラベルを見て入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제품은 찾았지만 영양 정보가 없습니다. 라벨을 보고 입력해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Produk ditemui, tetapi nilai pemakanannya tiada. Masukkan daripada labelnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Produktet ble funnet, men næringsverdiene mangler. Skriv dem inn fra etiketten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het product is gevonden, maar de voedingswaarden ontbreken. Vul ze in vanaf het etiket."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Produkt znaleziono, ale brakuje wartości odżywczych. Wpisz je z etykiety."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O produto foi encontrado, mas os valores nutricionais estão faltando. Insira-os a partir do rótulo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O produto foi encontrado, mas faltam os valores nutricionais. Introduza-os a partir do rótulo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Produsul a fost găsit, dar valorile nutriționale lipsesc. Introdu-le de pe etichetă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продукт найден, но пищевая ценность не указана. Введите её с этикетки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Produkt sa našiel, ale chýbajú mu nutričné hodnoty. Zadajte ich z etikety."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izdelek je bil najden, vendar manjkajo hranilne vrednosti. Vnesite jih z etikete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Produkten hittades, men näringsvärden saknas. Fyll i dem från etiketten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พบสินค้าแล้ว แต่ยังไม่มีค่าโภชนาการ กรอกข้อมูลจากฉลากได้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ürün bulundu ancak besin değerleri eksik. Değerleri etiketten girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продукт знайдено, але поживних значень немає. Введіть їх з етикетки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پروڈکٹ مل گئی، لیکن اس کی غذائی اقدار موجود نہیں۔ انہیں لیبل سے درج کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tìm thấy sản phẩm nhưng thiếu giá trị dinh dưỡng. Hãy nhập từ nhãn sản phẩm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已找到该食品，但缺少营养数值。请按照包装标签输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已找到產品，但缺少營養數值。請依照包裝標示輸入。"
          }
        }
      }
    },
