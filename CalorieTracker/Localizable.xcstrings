        }
      }
    },
    "This erases all products, diary entries and settings on this device.": {
      "comment": "A message in the alert that deletes all data.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى محو جميع المنتجات وإدخالات اليوميات والإعدادات على هذا الجهاز."
          }
