    "%@, locked. Upgrade to view older history.": {
      "comment": "A label for a locked day in the calendar.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@، مقفل. قم بالترقية لعرض السجل الأقدم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, লক করা আছে। পুরনো ইতিহাস দেখতে আপগ্রেড করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, uzamčeno. Starší historii zobrazíte po upgradu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, låst. Opgrader for at se ældre historik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, gesperrt. Upgrade, um älteren Verlauf zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, κλειδωμένη. Αναβαθμίστε για να δείτε παλαιότερο ιστορικό."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, bloqueado. Mejora tu plan para ver el historial anterior."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, lukittu. Päivitä nähdäksesi vanhemman historian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, verrouillé. Passez à Premium pour voir l’historique plus ancien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, נעול. שדרגו כדי לצפות בהיסטוריה ישנה יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, लॉक है। पुरानी हिस्ट्री देखने के लिए अपग्रेड करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, zaključano. Nadogradite za pregled starije povijesti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, zárolva. A régebbi előzményekhez válts Prémiumra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, terkunci. Tingkatkan untuk melihat riwayat lebih lama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, bloccato. Passa a Premium per vedere la cronologia precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、ロック中。過去の履歴を見るにはアップグレードが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, 잠김. 이전 기록을 보려면 업그레이드하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, dikunci. Naik taraf untuk melihat sejarah lebih lama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, låst. Oppgrader for å se eldre historikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, vergrendeld. Upgrade om oudere geschiedenis te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, zablokowane. Przejdź na Premium, aby zobaczyć starszą historię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, bloqueado. Faça upgrade para ver o histórico mais antigo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, bloqueado. Atualize para ver o histórico mais antigo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, blocat. Treci la Premium pentru a vedea istoricul mai vechi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, заблокировано. Оформите Премиум, чтобы видеть более раннюю историю."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, uzamknuté. Staršiu históriu zobrazíte s Premium."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, zaklenjeno. Nadgradite za ogled starejše zgodovine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, låst. Uppgradera för att se äldre historik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ล็อกอยู่ อัปเกรดเพื่อดูประวัติที่เก่ากว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, kilitli. Daha eski geçmişi görmek için yükseltin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, заблоковано. Оформіть Преміум, щоб переглядати давнішу історію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@، مقفل۔ پرانی ہسٹری دیکھنے کے لیے اپ گریڈ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, đã khóa. Nâng cấp để xem lịch sử cũ hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，已锁定。升级即可查看更早的历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，已鎖定。升級即可查看更久之前的歷史記錄。"
          }
        }
      }
