    "Tap a day with a ring to view details.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على يوم بحلقة لعرض التفاصيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিস্তারিত দেখতে রিং থাকা কোনও দিনে ট্যাপ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
