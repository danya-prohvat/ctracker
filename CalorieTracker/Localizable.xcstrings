        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό διαγράφει όλα τα προϊόντα, τις καταχωρίσεις ημερολογίου και τις ρυθμίσεις σε αυτήν τη συσκευή."
