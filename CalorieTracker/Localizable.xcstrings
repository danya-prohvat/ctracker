    "Swipe a row to delete · tap to edit quantity.": {
      "comment": "A footer for the diary list in a day view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب صفًا للحذف · اضغط لتعديل الكمية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মুছতে সারি সোয়াইপ করুন · পরিমাণ বদলাতে ট্যাপ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejetím po řádku smažete · klepnutím upravíte množství."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skub en række for at slette · tryk for at redigere mængden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeile wischen zum Löschen · tippen, um die Menge zu bearbeiten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε μια γραμμή για διαγραφή · πατήστε για επεξεργασία ποσότητας."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza una fila para eliminar · toca para editar la cantidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyhkäise riviä poistaaksesi · napauta muokataksesi määrää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez une ligne pour supprimer · touchez pour modifier la quantité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החליקו על שורה כדי למחוק · הקישו כדי לערוך כמות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिटाने के लिए पंक्ति स्वाइप करें · मात्रा बदलने के लिए टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povucite redak za brisanje · dodirnite za uređivanje količine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd el a sort a törléshez · koppints a mennyiség szerkesztéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser baris untuk menghapus · ketuk untuk mengedit jumlah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri su una riga per eliminare · tocca per modificare la quantità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプで削除 · タップで数量を編集。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밀어서 삭제 · 탭하여 섭취량 편집"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret baris untuk memadam · ketik untuk mengedit kuantiti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveip en rad for å slette · trykk for å endre mengde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg over een rij om te verwijderen · tik om de hoeveelheid te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń wiersz, aby usunąć · stuknij, aby edytować ilość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize uma linha para apagar · toque para editar a quantidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize uma linha para apagar · toque para editar a quantidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisează un rând pentru a șterge · atinge pentru a edita cantitatea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните строку, чтобы удалить · нажмите, чтобы изменить количество."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Riadok vymažete potiahnutím · množstvo upravíte ťuknutím."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrsajte vrstico za izbris · tapnite za spremembo količine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep på en rad för att radera · tryck för att ändra mängd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดแถวเพื่อลบ · แตะเพื่อแก้ไขปริมาณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silmek için satırı kaydırın · miktarı düzenlemek için dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змахніть рядок, щоб видалити · торкніться, щоб змінити кількість."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف کرنے کے لیے قطار پر سوائپ کریں · مقدار میں ترمیم کے لیے ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt hàng để xóa · chạm để sửa số lượng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动条目可删除 · 点按可编辑数量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑動列可刪除 · 點一下可編輯份量。"
          }
        }
      }
    },
