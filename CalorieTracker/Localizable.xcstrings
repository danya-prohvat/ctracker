        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึงกล้องเพื่อสแกนบาร์โค้ด หรือเพิ่มสินค้าด้วยตนเอง"
          }
        },
        "tr": {
          "stringUnit": {
