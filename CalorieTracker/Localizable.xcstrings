    "reengagement_day31": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حسنًا، فهمنا التلميح. سنختفي الآن، لكن الباب مفتوح 🚪"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঠিক আছে, ইঙ্গিতটা বুঝলাম। এখন বিদায় নিচ্ছি। তবে দরজা খোলা থাকল 🚪"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobře, chápeme. Už mizíme. Ale dveře zůstávají otevřené 🚪"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Okay, vi kan godt tage et hint. Vi forsvinder nu. Men døren står åben 🚪"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Okay, wir haben verstanden. Wir verschwinden. Aber die Tür bleibt offen 🚪"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εντάξει, το πιάσαμε το υπονοούμενο. Εξαφανιζόμαστε. Αλλά η πόρτα μένει ανοιχτή 🚪"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Okay, we can take a hint. Vanishing now. But the door's open 🚪"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale, captamos la indirecta. Nos vamos. Pero la puerta queda abierta 🚪"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Okei, ymmärrämme vihjeen. Hiljenemme nyt. Mutta ovi on auki 🚪"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’accord, on a compris. On s’éclipse. Mais la porte reste ouverte 🚪"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טוב, קלטנו את הרמז. נעלמים עכשיו. אבל הדלת פתוחה 🚪"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ठीक है, इशारा समझ गए। अब चलते हैं। पर दरवाज़ा खुला है 🚪"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobro, shvaćamo. Povlačimo se. Ali vrata su otvorena 🚪"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oké, értjük a célzást. Eltűnünk. De az ajtó nyitva áll 🚪"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Oke, kami paham. Kami pamit dulu, tapi pintunya selalu terbuka 🚪"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ok, messaggio ricevuto. Scompariamo. Ma la porta resta aperta 🚪"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "わかりました、そっとしておきますね。でもドアはいつでも開いています 🚪"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알겠어요, 눈치챘어요. 이만 조용히 있을게요. 문은 늘 열려 있어요 🚪"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baiklah, kami faham. Kami beredar dulu. Tapi pintu sentiasa terbuka 🚪"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Greit, vi skjønner tegninga. Vi forsvinner nå. Men døra står åpen 🚪"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oké, we snappen de hint. We verdwijnen. Maar de deur staat open 🚪"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobrze, rozumiemy aluzję. Znikamy. Ale drzwi są otwarte 🚪"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ok, entendemos o recado. Vamos sumir. Mas a porta está aberta 🚪"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está bem, percebemos a mensagem. Vamos desaparecer. Mas a porta fica aberta 🚪"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bine, am înțeles aluzia. Dispărem. Dar ușa rămâne deschisă 🚪"
          }
        },
        "ru": {
