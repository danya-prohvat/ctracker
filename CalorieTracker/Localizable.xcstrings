            "value": "যা খুশি বদলে নিন — পরে সেটিংসে পরিবর্তন করা যাবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravte si cokoli — později to změníte v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Juster hvad som helst – du kan ændre det senere i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe alles an – du kannst es später in den Einstellungen ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσαρμόστε ό,τι θέλετε — μπορείτε να το αλλάξετε αργότερα στις Ρυθμίσεις."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta lo que quieras: podrás cambiarlo más tarde en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säädä vapaasti — voit muuttaa kaiken myöhemmin Asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez ce que vous voulez — modifiable plus tard dans Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לכוונן הכול — וגם לשנות בהמשך בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी बदलें — बाद में सेटिंग्स में भी बदल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagodite što god želite — kasnije to možete promijeniti u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármin módosíthatsz — később a Beállításokban is átírhatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan apa saja — Anda bisa mengubahnya nanti di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica ciò che vuoi: potrai cambiarlo in seguito nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自由に調整できます。後から設定でも変更可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자유롭게 조정하세요 — 나중에 설정에서 변경할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laraskan apa-apa sahaja — anda boleh mengubahnya kemudian dalam Seting."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Juster det du vil – du kan endre det senere i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas alles naar wens aan — je kunt het later wijzigen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosuj wszystko — możesz to później zmienić w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste o que quiser — você pode mudar depois nos Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste o que quiser — pode alterar mais tarde nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustează orice — poți modifica mai târziu din Configurări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте под себя — это можно изменить позже в Настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravte si čokoľvek — neskôr to zmeníte v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagodite po želji — pozneje lahko vse spremenite v Nastavitvah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Justera vad du vill – du kan ändra det senare i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับได้ทุกอย่าง — เปลี่ยนทีหลังได้ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğinizi ayarlayın — daha sonra Ayarlar'dan değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте під себе — пізніше це можна змінити в Параметрах."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو چاہیں بدلیں — بعد میں ترتیبات میں تبدیل کیا جا سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chỉnh thoải mái — bạn có thể đổi lại trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可随意调整——之后也能在设置中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任意調整，之後也能在「設定」中更改。"
          }
        }
      }
    },
