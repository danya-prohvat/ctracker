        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akan dihapus dari jurnal Anda. Tindakan ini tidak dapat diurungkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sarà rimosso dal diario. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を食事記録から削除します。この操作は取り消せません。"
