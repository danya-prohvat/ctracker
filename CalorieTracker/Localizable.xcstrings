    "You're offline. Internet is needed only to look up scanned barcodes.": {
      "comment": "A message displayed when the user is offline.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت غير متصل بالإنترنت. الإنترنت مطلوب فقط للبحث عن الرموز الشريطية الممسوحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি অফলাইনে আছেন। শুধু স্ক্যান করা বারকোড খুঁজতেই ইন্টারনেট লাগে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jste offline. Internet je potřeba jen k vyhledání naskenovaných čárových kódů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er offline. Internet er kun nødvendigt for at slå scannede stregkoder op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline. Internet wird nur zum Nachschlagen gescannter Barcodes benötigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε εκτός σύνδεσης. Το διαδίκτυο χρειάζεται μόνο για την αναζήτηση σαρωμένων barcode."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión. Internet solo se necesita para buscar los códigos escaneados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet offline-tilassa. Internetiä tarvitaan vain skannattujen viivakoodien hakuun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Internet n’est nécessaire que pour rechercher les codes-barres scannés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין חיבור לאינטרנט. האינטרנט נדרש רק לחיפוש ברקודים שנסרקו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ऑफ़लाइन हैं। इंटरनेट केवल स्कैन किए गए बारकोड खोजने के लिए चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niste povezani. Internet je potreban samo za pretraživanje skeniranih barkodova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs internetkapcsolat. Az internet csak a beolvasott vonalkódok kikereséséhez szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sedang offline. Internet hanya diperlukan untuk mencari barcode yang dipindai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei offline. Internet serve solo per cercare i codici a barre scansionati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです。インターネット接続はスキャンしたバーコードの検索にのみ必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 상태입니다. 인터넷은 스캔한 바코드 조회에만 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda di luar talian. Internet hanya diperlukan untuk mencari kod bar yang diimbas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er frakoblet. Internett trengs bare for å slå opp skannede strekkoder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent offline. Internet is alleen nodig om gescande barcodes op te zoeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś offline. Internet jest potrzebny tylko do wyszukiwania zeskanowanych kodów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está offline. A internet só é necessária para consultar códigos de barras escaneados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está offline. A Internet só é necessária para consultar códigos de barras digitalizados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ești offline. Internetul e necesar doar pentru căutarea codurilor de bare scanate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы офлайн. Интернет нужен только для поиска отсканированных штрихкодов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ste offline. Internet je potrebný len na vyhľadanie naskenovaných čiarových kódov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niste povezani. Internet je potreben samo za iskanje skeniranih črtnih kod."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är offline. Internet behövs bara för att slå upp skannade streckkoder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณออฟไลน์อยู่ ต้องใช้อินเทอร์เน็ตเฉพาะตอนค้นหาบาร์โค้ดที่สแกนเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışısınız. İnternet yalnızca taranan barkodları sorgulamak için gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви офлайн. Інтернет потрібен лише для пошуку відсканованих штрихкодів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ آف لائن ہیں۔ انٹرنیٹ صرف اسکین شدہ بارکوڈز تلاش کرنے کے لیے درکار ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang ngoại tuyến. Chỉ cần mạng để tra cứu mã vạch đã quét."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前离线。仅在查询扫描的条形码时才需要网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前離線。只有查詢掃描的條碼時才需要網路。"
          }
        }
      }
    },
