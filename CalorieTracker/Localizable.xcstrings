          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso à câmera para escanear códigos de barras ou adicione o produto manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso à câmara para digitalizar códigos de barras ou adicione o produto manualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite accesul la cameră pentru a scana coduri de bare sau adaugă produsul manual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к камере для сканирования штрихкодов или добавьте продукт вручную."
          }
        },
        "sk": {
          "stringUnit": {
