    "This erases all products, diary entries and settings on this device and in iCloud.": {
      "comment": "A message in the alert that appears when the user deletes all data.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى محو جميع المنتجات وإدخالات اليوميات والإعدادات على هذا الجهاز وفي iCloud."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে এই ডিভাইস ও iCloud-এর সব পণ্য, ডায়েরি এন্ট্রি ও সেটিংস মুছে যাবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto smažete všechny produkty, záznamy v deníku a nastavení na tomto zařízení i na iCloudu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter alle produkter, dagbogsposter og indstillinger på denne enhed og i iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Produkte, Tagebucheinträge und Einstellungen auf diesem Gerät und in iCloud gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό διαγράφει όλα τα προϊόντα, τις καταχωρίσεις ημερολογίου και τις ρυθμίσεις σε αυτήν τη συσκευή και στο iCloud."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra todos los productos, entradas del diario y ajustes de este dispositivo y de iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa kaikki tuotteet, päiväkirjamerkinnät ja asetukset tältä laitteelta ja iCloudista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela efface tous les produits, les entrées du journal et les réglages sur cet appareil et dans iCloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מוחקת את כל המוצרים, רשומות היומן וההגדרות במכשיר זה וב-iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे इस डिवाइस और iCloud के सभी प्रोडक्ट, डायरी एंट्री और सेटिंग्स मिट जाएँगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo briše sve proizvode, unose dnevnika i postavke na ovom uređaju i u iCloudu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel törlődik minden termék, naplóbejegyzés és beállítás ezen az eszközön és az iCloudban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus semua produk, entri jurnal, dan pengaturan di perangkat ini dan di iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno eliminati tutti i prodotti, le voci del diario e le impostazioni su questo dispositivo e su iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスとiCloud上のすべての食品、食事記録、設定が消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기와 iCloud의 모든 제품, 식단 기록, 설정이 삭제됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memadamkan semua produk, entri diari dan seting pada peranti ini dan dalam iCloud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter alle produkter, dagbokoppføringer og innstillinger på denne enheten og i iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit wist alle producten, dagboekitems en instellingen op dit apparaat en in iCloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie wszystkich produktów, wpisów dziennika i ustawień na tym urządzeniu oraz w iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga todos os produtos, registros do diário e ajustes neste dispositivo e no iCloud."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto apaga todos os produtos, registos do diário e definições neste dispositivo e no iCloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vor șterge toate produsele, înregistrările din jurnal și configurările de pe acest dispozitiv și din iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит все продукты, записи дневника и настройки на этом устройстве и в iCloud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymažú sa všetky produkty, záznamy denníka a nastavenia na tomto zariadení aj v službe iCloud."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem izbrišete vse izdelke, vnose v dnevniku in nastavitve na tej napravi in v iCloudu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta raderar alla produkter, dagboksposter och inställningar på denna enhet och i iCloud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
