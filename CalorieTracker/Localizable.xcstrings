    "Used only to estimate your calorie needs.": {
      "comment": "Subtitle for the body step in the onboarding flow.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم فقط لتقدير احتياجك من السعرات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু আপনার ক্যালরির চাহিদা অনুমান করতে ব্যবহৃত হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používá se jen k odhadu vaší potřeby kalorií."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruges kun til at beregne dit kaloriebehov."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur genutzt, um deinen Kalorienbedarf zu schätzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιείται μόνο για την εκτίμηση των θερμιδικών σας αναγκών."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se usa para estimar tus necesidades calóricas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytetään vain kaloritarpeesi arviointiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé uniquement pour estimer vos besoins caloriques."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משמש רק להערכת צורכי הקלוריות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल आपकी कैलोरी ज़रूरत के अनुमान के लिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi se samo za procjenu vaših kalorijskih potreba."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a kalóriaszükségleted becslésére szolgál."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya digunakan untuk memperkirakan kebutuhan kalori Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve solo a stimare il tuo fabbisogno calorico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要カロリーの推定にのみ使用します。"
          }
        },
        "ko": {
