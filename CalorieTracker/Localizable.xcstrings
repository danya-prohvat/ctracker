        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשארו לכם עוד %@ קק״ל להיום. תעדו את ארוחת הערב!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
