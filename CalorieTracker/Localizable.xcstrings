    "Off = log once without saving": {
      "comment": "A description of the \"Save to My products\" toggle.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف = تسجيل لمرة واحدة دون حفظ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
