          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnuto = zaznamenat jednou bez uložení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra = log én gang uden at gemme"
          }
        },
