    "Pay once, keep forever": {
      "comment": "A description of a lifetime paywall plan.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ادفع مرة واحدة واحتفظ به للأبد"
