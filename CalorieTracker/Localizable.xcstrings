    "This barcode isn't in our database yet. You can add it manually.": {
      "comment": "A description of a product that isn't in the database.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الرمز الشريطي غير موجود في قاعدة بياناتنا بعد. يمكنك إضافته يدويًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বারকোডটি এখনও আমাদের ডেটাবেসে নেই। আপনি এটি ম্যানুয়ালি যোগ করতে পারেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento čárový kód zatím není v naší databázi. Můžete ho přidat ručně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne stregkode er ikke i vores database endnu. Du kan tilføje den manuelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Barcode ist noch nicht in unserer Datenbank. Du kannst ihn manuell hinzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το barcode δεν υπάρχει ακόμη στη βάση δεδομένων μας. Μπορείτε να το προσθέσετε χειροκίνητα."
