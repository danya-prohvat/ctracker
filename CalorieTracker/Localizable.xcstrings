    "Allow camera access to scan barcodes, or add the product manually.": {
      "comment": "A message displayed when camera access is denied.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى الكاميرا لمسح الرموز الشريطية، أو أضف المنتج يدويًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বারকোড স্ক্যান করতে ক্যামেরার অনুমতি দিন, অথবা পণ্যটি ম্যানুয়ালি যোগ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte přístup k fotoaparátu pro skenování čárových kódů, nebo přidejte produkt ručně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad kameraadgang for at scanne stregkoder, eller tilføj produktet manuelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Kamerazugriff, um Barcodes zu scannen, oder füge das Produkt manuell hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε την πρόσβαση στην κάμερα για σάρωση barcode ή προσθέστε το προϊόν χειροκίνητα."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a la cámara para escanear códigos de barras o añade el producto manualmente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli kameran käyttö viivakoodien skannausta varten tai lisää tuote käsin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à l’appareil photo pour scanner les codes-barres, ou ajoutez le produit manuellement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לאשר גישה למצלמה כדי לסרוק ברקודים, או להוסיף את המוצר ידנית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बारकोड स्कैन करने के लिए कैमरा एक्सेस दें, या प्रोडक्ट मैन्युअली जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite pristup kameri za skeniranje barkodova ili dodajte proizvod ručno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a kamerahozzáférést a vonalkódok beolvasásához, vagy add hozzá a terméket kézzel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses kamera untuk memindai barcode, atau tambahkan produk secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso alla fotocamera per scansionare i codici a barre, oppure aggiungi il prodotto manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーコードをスキャンするにはカメラへのアクセスを許可するか、商品を手動で追加してください。"
