    "Unusual plan — double-check your numbers.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطة غير معتادة — تحقق من أرقامك جيدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অস্বাভাবিক প্ল্যান — সংখ্যাগুলো আবার যাচাই করুন।"
          }
        },
        "cs": {
