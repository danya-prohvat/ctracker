          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بارکوڈ اسکین کرنے کے لیے کیمرے تک رسائی کی اجازت دیں، یا پروڈکٹ دستی طور پر شامل کریں۔"
