    "reengagement_day14": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المشكلة ليست فينا، بل فيك. لكننا مستعدون للمسامحة 💔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দোষটা আমাদের নয়, আপনার। তবে আমরা ক্ষমা করতে প্রস্তুত 💔"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není to námi, je to vámi. Ale rádi vám odpustíme 💔"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke os, det er dig. Men vi er klar til at tilgive 💔"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es liegt nicht an uns, sondern an dir. Aber wir verzeihen dir 💔"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν φταίμε εμείς, φταίτε εσείς. Αλλά είμαστε έτοιμοι να σας συγχωρήσουμε 💔"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's not us, it's you. But we're ready to forgive 💔"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No somos nosotros, eres tú. Pero estamos listos para perdonarte 💔"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei se meistä johdu, vaan sinusta. Mutta annamme anteeksi 💔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas nous, c’est vous. Mais on est prêts à pardonner 💔"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה לא אנחנו, זה אתם. אבל אנחנו מוכנים לסלוח 💔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बात हमारी नहीं, आपकी है। पर हम माफ़ करने को तैयार हैं 💔"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nismo mi, vi ste. Ali spremni smo oprostiti 💔"
          }
