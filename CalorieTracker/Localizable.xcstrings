        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi kameratilgang for å skanne strekkoder, eller legg til produktet manuelt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta cameratoegang toe om barcodes te scannen, of voeg het product handmatig toe."
          }
