        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 식단 기록에서 삭제됩니다. 이 동작은 취소할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akan dibuang daripada diari anda. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fjernes fra dagboken din. Dette kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wordt uit je dagboek verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpis „%@” zostanie usunięty z dziennika. Tego nie można cofnąć."
