          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en dag med en ring for at se detaljer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Tag mit Ring, um Details zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε μια ημέρα με δακτύλιο για λεπτομέρειες."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un día con anillo para ver los detalles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta päivää, jossa on rengas, niin näet tiedot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un jour avec un anneau pour voir les détails."
