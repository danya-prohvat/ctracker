    "%@ will be removed from your diary. This can't be undone.": {
      "comment": "A confirmation message for a diary entry deletion. The argument is the name of the diary entry's product.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة %@ من يومياتك. لا يمكن التراجع عن ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ আপনার ডায়েরি থেকে মুছে ফেলা হবে। এটি আর ফেরানো যাবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položka %@ bude odstraněna z deníku. Tuto akci nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fjernes fra din dagbog. Dette kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird aus deinem Tagebuch entfernt. Das lässt sich nicht rückgängig machen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» θα αφαιρεθεί από το ημερολόγιό σας. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se eliminará de tu diario. Esta acción no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ poistetaan päiväkirjastasi. Tätä ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sera supprimé de votre journal. Cette action est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ יוסר מהיומן שלך. פעולה זו אינה ניתנת לביטול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ आपकी डायरी से हटा दिया जाएगा। इसे वापस नहीं लाया जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ će biti uklonjeno iz dnevnika. To se ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ törlődik a naplódból. Ez nem vonható vissza."
