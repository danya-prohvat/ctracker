            "state": "translated",
            "value": "칼로리 필요량 계산에만 사용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan hanya untuk menganggar keperluan kalori anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brukes kun til å beregne kaloribehovet ditt."
          }
        },
